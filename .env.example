# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.

# Discord Developer Portal > tu aplicación
DISCORD_TOKEN=token_del_bot
CLIENT_ID=id_de_la_aplicacion
# Servidor donde se registran los slash commands
GUILD_ID=id_del_servidor

# Supabase > Project Settings > Data API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-key

# Opcionales
BIRTHDAY_TIMEZONE=America/Merida
# Carpeta del estado local (cumpleaños, equipos, canales de voz). Por defecto ./data.
# Para un bot de pruebas usa una carpeta propia, por ejemplo ./data-test.
# DATA_DIR=./data-test
